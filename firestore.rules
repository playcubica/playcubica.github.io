rules_version = '2';
// Cubica cloud saves. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // Older personal saves (each moves to worlds/ the next time it is saved).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared worlds: every member can read, play (host) and save them; only the owner deletes;
    // nobody can take a world over.
    match /worlds/{worldId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;

      match /chunks/{chunk} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/worlds/$(worldId)).data.members;
        allow write: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/worlds/$(worldId)).data.members;
      }
    }
  }
}
